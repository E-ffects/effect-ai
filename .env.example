# Copy to .env (never committed) and fill in.
# LLM for sentences. "provider:model", or off for templates only.
RMA_LLM=openai:gpt-5.4-mini
OPENAI_API_KEY=
# LangSmith tracing (optional)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=effect-ai
# Team PostgreSQL (optional, read-only account). Empty = local SQLite data/pcb_rma_v5.sqlite
RMA_DATABASE_URL=
# Schema that holds the PCB tables in the team DB
RMA_DB_SCHEMA=pcb
# Learned reordering of the top 3 cause candidates (WBS 4.12). Empty/off = hand-set score only (default)
RMA_CAUSE_RANKER=
# AI server (server/app.py): same value as Spring jwt.secret. RMA_AUTH=off skips the token check (local only)
RMA_SERVICE_JWT_SECRET=
